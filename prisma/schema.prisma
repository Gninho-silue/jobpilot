generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

enum ApplicationStatus {
  APPLIED
  PHONE
  TECHNICAL
  OFFER
  REJECTED
}

enum Language {
  FR
  EN
}

model User {
  id               String        @id
  email            String        @unique
  plan             Plan          @default(FREE)
  stripeCustomerId String?       @unique
  cvPath           String?       // "<userId>/cv.pdf" in the private `cvs` bucket, never a URL
  cvText           String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  applications     Application[]
  usage            UsageCounter?
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       String
  role          String
  status        ApplicationStatus @default(APPLIED)
  language      Language          @default(EN)
  offerText     String            @db.Text
  salary        String?
  link          String?
  notes         String?           @db.Text
  adaptedCvUrl  String?
  adaptedCvText String?           @db.Text
  coverLetter   String?           @db.Text
  interviewQs   Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

model UsageCounter {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         String
  cvAdaptations Int      @default(0)
  coverLetters  Int      @default(0)
  applications  Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// One row per rate-limited request, kept only for the length of the window
// (see src/lib/rate-limit.ts). Shared by every serverless instance.
model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Billing webhook events already applied, so a redelivered event is a no-op.
// id = "<provider>:<provider event id>" (see src/lib/billing).
model ProcessedBillingEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
