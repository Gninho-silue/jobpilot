# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq
GROQ_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=

# App: public address (production builds fail without an https one; see src/lib/env.ts)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo workspace (optional: without DEMO_COOKIE_SECRET the demo is disabled)
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEMO_COOKIE_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/purge-demo
CRON_SECRET=

# Clerk telemetry off (its notice floods the Vercel logs). @clerk/nextjs reads the
# NEXT_PUBLIC_ one on the server; the other one is for Clerk's other SDKs.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
CLERK_TELEMETRY_DISABLED=1
